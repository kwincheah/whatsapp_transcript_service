# Values only: no quotes, no spaces, no trailing comments.

# ===== Required =====

# WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
# Permanent System User token. Starts with EAA, ~200 chars.
WHATSAPP_TOKEN=
# The bot number's Phone number ID (long numeric ID, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ===== Recommended =====

# App settings -> Basic -> App secret (32 chars). Enables webhook signature checks.
WHATSAPP_APP_SECRET=
# Numbers allowed to use the bot: country code, no +, comma-separated.
ALLOWED_SENDERS=60123456789

# ===== Optional =====

# Speech-to-text
STT_MODEL=gpt-4o-mini-transcribe
# Names/jargon to spell correctly, comma-separated (users can add more with /vocab).
STT_VOCAB=

# Analysis
SUMMARY_MODEL=deepseek-v4-flash
SUMMARY_THINKING=false
# Summary for audio longer than this; key points for audio longer than KEY_POINTS_MIN_SECONDS.
SUMMARY_MIN_SECONDS=8
KEY_POINTS_MIN_SECONDS=60
# Translate into this language by default, e.g. English (users can change it with /lang). Empty = off.
TRANSLATE_TO=

# Output token budgets per task
VOICE_SUMMARY_MAX_TOKENS=150
VOICE_KEY_POINTS_MAX_TOKENS=350
TRANSLATION_MAX_TOKENS=4000
DOC_MAX_OUTPUT_TOKENS=1500

# Document input limits
DOC_MAX_BYTES=20971520
DOC_MAX_INPUT_CHARS=150000

# History for /stats and /search (mount a Railway volume at /app/data to keep it). Empty = off.
DB_PATH=data/bot.db

# Cost estimates in USD
PRICE_STT_PER_MIN=0.003
PRICE_LLM_INPUT_PER_M=0.30
PRICE_LLM_CACHED_INPUT_PER_M=0.006
PRICE_LLM_OUTPUT_PER_M=1.20

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup) ---
WHATSAPP_TOKEN=            # permanent System User token (temporary tokens expire in 24h)
WHATSAPP_PHONE_NUMBER_ID=  # the bot's phone number ID (not the phone number itself)
WHATSAPP_VERIFY_TOKEN=     # any random string; paste the same into the webhook config
WHATSAPP_APP_SECRET=       # App Settings -> Basic -> App secret (enables signature check)
# Only these numbers get replies (country code, no +). Strongly recommended.
ALLOWED_SENDERS=60123456789

# --- Speech-to-text ---
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# --- Summary ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUMMARY_MODEL=deepseek-v4-flash
SUMMARY_MIN_SECONDS=8
SUMMARY_MAX_TOKENS=80

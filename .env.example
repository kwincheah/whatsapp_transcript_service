# Values only: no quotes, no spaces, no trailing comments.

# --- WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup) ---
# Permanent System User token (temporary tokens expire in 24h). Starts with EAA, ~200 chars.
WHATSAPP_TOKEN=
# The bot number's Phone number ID (long numeric ID, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; enter the same value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret (32 chars). Enables webhook signature checks.
WHATSAPP_APP_SECRET=
# Numbers allowed to use the bot: country code, no +, comma-separated. Strongly recommended.
ALLOWED_SENDERS=60123456789

# --- Speech-to-text ---
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# --- Summary ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUMMARY_MODEL=deepseek-v4-flash
SUMMARY_MIN_SECONDS=8
SUMMARY_MAX_TOKENS=80
